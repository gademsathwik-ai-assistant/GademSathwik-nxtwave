{
  "name": "campusresolve-monorepo",
  "version": "1.0.0",
  "description": "CampusResolve - College Complaint & Grievance Management System",
  "private": true,
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "seed": "cd server && npm run seed"
    "start": "cd server && npm run dev",

  },
  "keywords": ["college-complaints", "grievance", "express", "nextjs", "socketio", "typescript", "mongodb"],
  "author": "CampusResolve Engineering Team",
  "license": "ISC"
}
