# CampusResolve Backend Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration (If omitted or unreachable, in-memory MongoDB will auto-boot)
MONGO_URI=mongodb://localhost:27017/campusresolve

# Authentication
JWT_SECRET=campusresolve_jwt_super_secret_key_2026_secure
JWT_EXPIRES_IN=7d

# Redis Configuration for BullMQ (Optional - auto-falls back to built-in interval scheduler)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# AI Categorization (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
