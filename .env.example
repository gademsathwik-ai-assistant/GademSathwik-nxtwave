# ========================================================
# CampusResolve - Environment Configuration Template
# ========================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
# Note: In-memory MongoDB starts automatically if local MongoDB is not running!
MONGO_URI=mongodb://localhost:27017/campusresolve

# Authentication & Security
JWT_SECRET=campusresolve_jwt_super_secret_key_2026_secure
JWT_EXPIRES_IN=7d

# Redis / BullMQ (Optional - in-memory fallback enabled by default)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# AI Categorization (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
